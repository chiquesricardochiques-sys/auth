# Copie para .env (que está no .gitignore) e preencha. NUNCA commite o .env.
# Comentários ficam em linhas próprias, acima da variável.

# development ou production
AUTH_ENV=development
AUTH_PORT=8080

# ---------- Banco ----------
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=troque-esta-senha
DB_NAME=ricardo_platform
# cria as tabelas que faltarem ao iniciar
AUTH_AUTO_MIGRATE=true

# ---------- Segredo dos códigos (obrigatório, 32+ caracteres) ----------
# Linux/Mac: openssl rand -hex 32
# Windows (PowerShell): veja o README
AUTH_CODE_SECRET=
AUTH_CODE_TTL_MINUTES=15

# ---------- Email ----------
# smtp = envia de verdade | log = só escreve o código no log (apenas desenvolvimento)
AUTH_MAIL_MODE=log
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
# starttls (porta 587) | ssl (porta 465) | none (só servidor local)
EMAIL_SMTP_TLS=starttls
EMAIL_SMTP_USER=
# Gmail: use uma "senha de app" NOVA (a antiga foi exposta)
EMAIL_SMTP_PASSWORD=
# ex: RICARDO AUTH <voce@gmail.com>
EMAIL_FROM=

# Devolve o código na resposta de /register e /recovery. Só para teste local;
# o programa se recusa a iniciar com isso ligado em produção.
AUTH_DEV_RETURN_CODE=false

# ---------- Sessão / cookie ----------
AUTH_SESSION_TTL_HOURS=720
AUTH_COOKIE_NAME=auth_session
# SSO entre subdomínios: .seudominio.com (vazio = só o host atual)
AUTH_COOKIE_DOMAIN=
# vazio = true em produção, false em desenvolvimento
AUTH_COOKIE_SECURE=

# ---------- HTTP ----------
AUTH_CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# true só se houver proxy reverso seu na frente (nginx, caddy...)
AUTH_TRUST_PROXY=false

# ---------- Outros backends (introspecção de token) ----------
# formato nome:chave, separados por vírgula; chave com 24+ caracteres
# deixe vazio se não for usar o /introspect
AUTH_SERVICE_KEYS=
